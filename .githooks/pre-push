#!/bin/sh
# Remote branch names (type/description, preview host length), then tests and the full lint.
# Git passes the remote name and URL as $1 and $2, and one line per ref on stdin:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# See RULES.md.
. "$(dirname "$0")/_common.sh"

remote_url="$2"
pushed=0
failed=0

while read -r local_ref local_sha rest; do
  # the remote sha is the last field, so a (malformed) ref with spaces is still checked whole
  remote_ref="${rest% *}"
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;; # tags and other refs
  esac
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;; # branch deletion
  esac
  branch="${remote_ref#refs/heads/}"
  if node tools/rules.mjs branch "$branch" --remote-url "$remote_url"; then
    pushed=1
  else
    failed=1
  fi
done

[ "$failed" = "1" ] && exit 1
[ "$pushed" = "0" ] && exit 0

require_dependencies

if node -e "process.exit(require('./package.json').scripts?.test ? 0 : 1)"; then
  npm test || { echo "Push blocked: npm test failed." >&2; exit 1; }
fi

npm run lint || { echo "" >&2; echo "Push blocked: npm run lint failed." >&2; exit 1; }
