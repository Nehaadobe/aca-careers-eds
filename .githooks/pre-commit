#!/bin/sh
# No commits on main, no changes to the vendored scripts/aem.js, block READMEs, lint of the staged
# js/mjs/css files. See RULES.md.
. "$(dirname "$0")/_common.sh"

branch="$(git symbolic-ref --short -q HEAD)"
if [ "$branch" = "main" ] && [ "$ALLOW_MAIN" != "1" ]; then
  echo "" >&2
  echo "Commit blocked: you are on main. Create a branch (e.g. git switch -c feature/my-change)," >&2
  echo "or set ALLOW_MAIN=1 if you really must commit here." >&2
  echo "" >&2
  exit 1
fi

exec node tools/rules.mjs pre-commit
